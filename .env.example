# Copy to .env and fill in to enable real email delivery.
# Without these, the app still works and writes an HTML email preview to ./previews.

PORT=3000

# SMTP (e.g. SendGrid, Mailgun, Amazon SES, Postmark, or a Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The From address shown on the report email
MAIL_FROM=Domain Scanner <scanner@yourdomain.com>
